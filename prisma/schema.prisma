generator client {
  provider = "prisma-client-js"
  // One SQL query per read instead of one per relation: each round trip to the database is slow.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  IMPORTER
  TRUCK_OWNER
  ADMIN
  DRIVER
}

enum TruckStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  DISPUTED
  REJECTED
  /// Importer cancelled before paying, or the booking expired unpaid. The truck is freed.
  CANCELLED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum BookingPaymentStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
}

enum PaymentMethod {
  MTN
  AIRTEL
  VISA
}

enum WalletTransactionType {
  DEPOSIT
  BOOKING_PAYMENT
  BOOKING_EARNING
  WITHDRAWAL
  REFUND
  PLATFORM_COMMISSION
}

enum WalletTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  location     String?
  company      String?
  photo        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trucks              Truck[]
  bookings            Booking[]
  disputes            Dispute[]            @relation("RaisedDisputes")
  wallet              Wallet?
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Truck {
  id              String      @id @default(uuid())
  ownerId         String
  plateNumber     String      @unique
  truckType       String
  capacity        Float
  /// Legacy fixed price, no longer used: trips are priced per kilometre.
  priceRwf        Int?
  /// Size class, e.g. "Heavy truck"; used to filter the marketplace.
  category        String?
  /// The owner's rate. A trip costs the road distance to the destination times this rate.
  pricePerKmRwf   Int?
  /// Places the owner delivers to; importers choose their destination from these.
  destinations    String[]    @default([])
  /// Cargo the vehicle is suited to carry.
  acceptedCargo   String[]    @default([])
  currentLocation String?
  preferredRoute  String?
  description     String?
  photos          String[]    @default([])
  status          TruckStatus @default(AVAILABLE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  @@index([ownerId])
  @@index([status])
  @@index([truckType])
  @@index([currentLocation])
}

model Booking {
  id                   String        @id @default(uuid())
  truckId              String
  importerId           String
  cargoType            String
  cargoDescription     String?
  cargoWeight          Float
  pickupLocation       String
  destination          String
  pickupDate           DateTime
  expectedDeliveryDate DateTime
  status               BookingStatus @default(PENDING)
  additionalInstructions String?
  agreedPrice          String        @default("")
  agreedPriceRwf       Int?
  /// Road distance from the vehicle's location to the destination, measured when booking.
  distanceKm           Float?
  /// The vehicle's rate when the booking was made.
  pricePerKmRwf        Int?
  trackingLatitude     Float?
  trackingLongitude    Float?
  trackingAccuracy     Float?
  trackingUpdatedAt    DateTime?
  /// When the owner accepted; the importer then has the payment window to pay the deposit.
  acceptedAt           DateTime?
  /// Where the vehicle was when booked: the trip starts and ends there.
  truckLocation        String?
  pickupCountry        String?
  pickupCity           String?
  /// District, sector or neighbourhood of the pickup.
  pickupArea           String?
  destinationCountry   String?
  destinationCity      String?
  destinationArea      String?
  /// Priced legs: vehicle location → pickup → destination → back to the vehicle location.
  routeLegs            Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  truck                Truck         @relation(fields: [truckId], references: [id], onDelete: Restrict)
  importer             User          @relation(fields: [importerId], references: [id], onDelete: Restrict)
  dispute              Dispute?
  payment              BookingPayment?
  walletTransactions   WalletTransaction[]
  documents            BookingDocument[]
  delays               TripDelay[]
  delayImpacts         DelayImpact[]

  @@index([truckId])
  @@index([truckId, pickupDate])
  @@index([importerId])
  @@index([status])
  @@index([pickupDate])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balanceRwf   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String                     @id @default(uuid())
  walletId          String
  bookingId         String?
  type              WalletTransactionType
  status            WalletTransactionStatus    @default(PENDING)
  direction         WalletTransactionDirection
  amountRwf         Int
  reference         String                     @unique
  providerReference String?                    @unique
  description       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  wallet            Wallet                     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  booking           Booking?                   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([walletId, status])
  @@index([bookingId])
}

model BookingPayment {
  id                 String               @id @default(uuid())
  bookingId          String               @unique
  status             BookingPaymentStatus @default(PENDING)
  amountRwf          Int
  commissionRwf      Int
  ownerAmountRwf     Int
  /// How the importer paid, as chosen at checkout. Null on payments made before it was stored.
  method             PaymentMethod?
  payerName          String?
  /// Masked only ("**** 4242", "0788 *** 220"); a full card or phone number is never stored.
  accountMask        String?
  fundedAt           DateTime?
  releasedAt         DateTime?
  /// First instalment (half the price), paid within the window after the owner accepts. While
  /// only the deposit is paid, `amountRwf` is the deposit; paying the balance raises it to the price.
  depositRwf         Int?
  /// Second instalment, paid when the importer confirms receipt of the cargo.
  balanceRwf         Int?
  balancePaidAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model Dispute {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  raisedBy       String
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNotes String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raiser         User          @relation("RaisedDisputes", fields: [raisedBy], references: [id], onDelete: Restrict)

  @@index([raisedBy])
  @@index([status])
}

/// Cargo and tax documents the importer uploads after paying the deposit, before the trip starts.
model BookingDocument {
  id           String   @id @default(uuid())
  bookingId    String
  uploadedById String
  /// CARGO (packing list, bill of lading, invoice), TAX (customs declaration, tax receipt) or OTHER.
  kind         String
  name         String
  mimeType     String
  sizeBytes    Int
  /// Stored inline as a data URL, like the other uploads; never sent in lists.
  dataUrl      String
  createdAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// A delay reported during a trip: the trip's last day moves later by `delayDays`.
model TripDelay {
  id               String   @id @default(uuid())
  bookingId        String
  reportedById     String
  delayDays        Int
  reason           String
  previousEndDate  DateTime
  newEndDate       DateTime
  createdAt        DateTime @default(now())

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  impacts DelayImpact[]

  @@index([bookingId])
}

/// A later booking of the same vehicle that a delay overlaps. Its importer chooses to shift the
/// dates (later bookings that then overlap shift too) or to cancel with a full refund.
model DelayImpact {
  id         String    @id @default(uuid())
  delayId    String
  bookingId  String
  shiftDays  Int
  /// PENDING (waiting for the importer), SHIFTED or REFUNDED.
  status     String    @default("PENDING")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  delay   TripDelay @relation(fields: [delayId], references: [id], onDelete: Cascade)
  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

model OperationsRecord {
  id          String   @id @default(uuid())
  domain      String
  recordId    String
  ownerId     String?
  audience    String?
  parentId    String?
  status      String?
  truckId     String?
  searchText  String   @default("")
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([domain, recordId])
  @@index([domain, ownerId, updatedAt])
  @@index([domain, parentId, status])
  @@index([domain, truckId, parentId])
}
