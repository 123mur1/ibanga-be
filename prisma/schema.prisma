generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  IMPORTER
  TRUCK_OWNER
  ADMIN
}

enum TruckStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  DISPUTED
  REJECTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum BookingPaymentStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
}

enum WalletTransactionType {
  DEPOSIT
  BOOKING_PAYMENT
  BOOKING_EARNING
  WITHDRAWAL
  REFUND
  PLATFORM_COMMISSION
}

enum WalletTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         UserRole
  location     String?
  company      String?
  photo        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trucks       Truck[]
  bookings     Booking[]
  disputes     Dispute[] @relation("RaisedDisputes")
  wallet       Wallet?

  @@index([role])
}

model Truck {
  id              String      @id @default(uuid())
  ownerId         String
  plateNumber     String      @unique
  truckType       String
  capacity        Float
  priceRwf        Int?
  currentLocation String?
  preferredRoute  String?
  description     String?
  photos          String[]    @default([])
  status          TruckStatus @default(AVAILABLE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  @@index([ownerId])
  @@index([status])
  @@index([truckType])
  @@index([currentLocation])
}

model Booking {
  id                   String        @id @default(uuid())
  truckId              String
  importerId           String
  cargoType            String
  cargoDescription     String?
  cargoWeight          Float
  pickupLocation       String
  destination          String
  pickupDate           DateTime
  expectedDeliveryDate DateTime
  status               BookingStatus @default(PENDING)
  additionalInstructions String?
  agreedPrice          String        @default("")
  agreedPriceRwf       Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  truck                Truck         @relation(fields: [truckId], references: [id], onDelete: Restrict)
  importer             User          @relation(fields: [importerId], references: [id], onDelete: Restrict)
  dispute              Dispute?
  payment              BookingPayment?
  walletTransactions   WalletTransaction[]

  @@index([truckId])
  @@index([importerId])
  @@index([status])
  @@index([pickupDate])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balanceRwf   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String                     @id @default(uuid())
  walletId          String
  bookingId         String?
  type              WalletTransactionType
  status            WalletTransactionStatus    @default(PENDING)
  direction         WalletTransactionDirection
  amountRwf         Int
  reference         String                     @unique
  providerReference String?                    @unique
  description       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  wallet            Wallet                     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  booking           Booking?                   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([walletId, status])
  @@index([bookingId])
}

model BookingPayment {
  id                 String               @id @default(uuid())
  bookingId          String               @unique
  status             BookingPaymentStatus @default(PENDING)
  amountRwf          Int
  commissionRwf      Int
  ownerAmountRwf     Int
  fundedAt           DateTime?
  releasedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model Dispute {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  raisedBy       String
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNotes String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raiser         User          @relation("RaisedDisputes", fields: [raisedBy], references: [id], onDelete: Restrict)

  @@index([raisedBy])
  @@index([status])
}
