DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=3001
JWT_SECRET="change-me"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="https://ibanga-fe-611u.vercel.app"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="your-gmail-address@gmail.com"
SMTP_FROM_NAME="iBanga"
# Optional trusted CA PEM path for networks that inspect TLS certificates.
# SMTP_TLS_CA_PATH="C:/certs/network-root-ca.pem"
PAYMENT_COMMISSION_BPS=600
# Minutes an importer has, after the owner accepts, to pay the 50% deposit before the booking is
# cancelled and its days freed. Requests the owner has not answered never expire.
BOOKING_PAYMENT_WINDOW_MINUTES=60
# Google Maps Routes API key (enable "Routes API" on it). Used to measure trip distances and
# price bookings. Without it, distances are estimated from the listed places' coordinates.
GOOGLE_MAPS_API_KEY=
# Seeded truck owner (npm run prisma:seed). If no password is given, one is generated and printed.
SEED_OWNER_EMAIL=fleet@ibanga.rw
SEED_OWNER_PASSWORD=
